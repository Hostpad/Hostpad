<ui:FluentWindow x:Class="Hostpad.App.PasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Hostpad"
                 Width="400"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 Icon="Assets/hostpad.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Hostpad" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,10" />

            <ui:PasswordBox x:Name="Entry" KeyDown="OnKeyDown" />

            <TextBlock x:Name="Error"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       FontSize="11"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="Cancel" Click="OnCancel" Padding="14,5" />
                <ui:Button Content="OK" Appearance="Primary" Click="OnOk" Margin="8,0,0,0" Padding="18,5" />
            </StackPanel>
        </StackPanel>
    </Grid>

</ui:FluentWindow>
