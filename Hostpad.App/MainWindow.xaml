<ui:FluentWindow x:Class="Hostpad.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:Hostpad.App"
                 xmlns:vm="clr-namespace:Hostpad.App.ViewModels"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Hostpad"
                 Width="900"
                 Height="620"
                 MinWidth="640"
                 MinHeight="420"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <local:ProtocolNameConverter x:Key="ProtocolName" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One height for every control in the list toolbar, so they line up. -->
        <sys:Double x:Key="ToolBarHeight">34</sys:Double>

        <!--
          BasedOn is load-bearing: without it this replaces WPF-UI's default
          style outright, taking the control template with it, and the icon
          renders as an empty box.
        -->
        <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="{StaticResource ToolBarHeight}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Hostpad">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="BookContacts24" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button Appearance="Transparent"
                           Icon="{ui:SymbolIcon Settings24}"
                           ToolTip="Options and import/export"
                           Click="OnSettingsClick"
                           Margin="0,0,4,0" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                  A grid, not a stack: the search box takes whatever width is
                  left so the flat-list button stays pinned to the right edge of
                  the pane at any window size.
                -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               Style="{StaticResource ToolButton}"
                               Icon="{ui:SymbolIcon Add24}"
                               ToolTip="New connection in the selected group"
                               Command="{Binding NewConnectionCommand}" />
                    <ui:Button Grid.Column="1"
                               Style="{StaticResource ToolButton}"
                               Icon="{ui:SymbolIcon FolderAdd24}"
                               ToolTip="New group"
                               Margin="4,0,0,0"
                               Command="{Binding NewGroupCommand}" />
                    <ui:TextBox x:Name="SearchBox"
                                Grid.Column="2"
                                Height="{StaticResource ToolBarHeight}"
                                Margin="6,0,4,0"
                                VerticalContentAlignment="Center"
                                PlaceholderText="Search"
                                Icon="{ui:SymbolIcon Search24}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    <ui:Button Grid.Column="3"
                               Style="{StaticResource ToolButton}"
                               Icon="{ui:SymbolIcon List24}"
                               ToolTip="Show as a flat list"
                               Command="{Binding ToggleGroupingCommand}" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TreeView x:Name="Tree"
                              ItemsSource="{Binding Nodes}"
                              Background="Transparent"
                              BorderThickness="0"
                              AllowDrop="True"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              MouseMove="OnTreeMouseMove"
                              PreviewMouseLeftButtonDown="OnTreeMouseDown"
                              MouseDoubleClick="OnTreeDoubleClick"
                              DragOver="OnTreeDragOver"
                              Drop="OnTreeDrop"
                              KeyDown="OnTreeKeyDown">

                        <TreeView.ItemContainerStyle>
                            <!--
                              BasedOn again: without it the rows fall back to the
                              stock WPF style, which paints black text regardless
                              of the theme.
                            -->
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:GroupNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ui:FontIcon Glyph="{Binding Icon}"
                                                 FontFamily="{StaticResource FluentIconFont}"
                                                 FontSize="15"
                                                 Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="120"
                                             Padding="2,0"
                                             Loaded="OnRenameBoxLoaded"
                                             LostFocus="OnRenameBoxDone"
                                             KeyDown="OnRenameBoxKey"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding ConnectionCount}"
                                               Margin="8,0,0,0"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type vm:ConnectionNode}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ui:FontIcon Glyph="{Binding Icon}"
                                                 FontFamily="{StaticResource FluentIconFont}"
                                                 FontSize="15"
                                                 Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ui:FontIcon Glyph="{Binding JumpIcon}"
                                                 FontFamily="{StaticResource FluentIconFont}"
                                                 FontSize="13"
                                                   Margin="6,0,0,0"
                                                   ToolTip="Reached through a jump host"
                                                   Visibility="{Binding HasJumpHost, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>

                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="TreeMenu" Opened="OnTreeMenuOpened" />
                        </TreeView.ContextMenu>
                    </TreeView>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          Background="Transparent"
                          HorizontalAlignment="Center" />

            <Grid Grid.Column="2" IsEnabled="{Binding Editor.HasConnection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Hostname[:port]" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding Editor.Host, UpdateSourceTrigger=PropertyChanged}"
                                FontFamily="Cascadia Mono, Consolas" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Editor.Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                        <ui:PasswordBox Password="{Binding Editor.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        RevealButtonEnabled="True" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Editor.Protocols}"
                              SelectedItem="{Binding Editor.Protocol}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ProtocolName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,8">
                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Text="{Binding Editor.Notes, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                MinHeight="90"
                                Height="Auto"
                                VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Style="{StaticResource ToolButton}"
                               Icon="{ui:SymbolIcon Checkmark24}"
                               ToolTip="Apply changes"
                               Command="{Binding ApplyCommand}" />
                    <ui:Button Style="{StaticResource ToolButton}"
                               Icon="{ui:SymbolIcon Copy24}"
                               ToolTip="Duplicate"
                               Margin="4,0,0,0"
                               Command="{Binding DuplicateCommand}" />
                    <ui:Button Style="{StaticResource ToolButton}"
                               Icon="{ui:SymbolIcon Delete24}"
                               ToolTip="Delete"
                               Margin="4,0,0,0"
                               Command="{Binding DeleteCommand}" />
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon PlugConnected24}"
                               Content="Connect"
                               HorizontalAlignment="Right"
                               Margin="12,0,0,0"
                               Command="{Binding ConnectCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Border>
    </Grid>

</ui:FluentWindow>
