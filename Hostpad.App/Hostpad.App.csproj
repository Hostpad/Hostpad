<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Hostpad.App</RootNamespace>
    <AssemblyName>Hostpad</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\hostpad.ico</ApplicationIcon>
    <!-- Framework-dependent: users install the .NET runtime once, downloads stay small. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hostpad.Core\Hostpad.Core.csproj" />
  </ItemGroup>

  <!--
    Which of the release downloads this build is (Folder, Standalone or
    SingleFile), passed by the release workflow. The updater uses it to replace
    a copy with the same kind of file; a build without it never updates itself.
  -->
  <ItemGroup Condition="'$(HostpadDistribution)' != ''">
    <AssemblyMetadata Include="HostpadDistribution" Value="$(HostpadDistribution)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hostpad.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\hostpad.png" />
    <Resource Include="Assets\hostpad.ico" />
  </ItemGroup>

  <!--
    Embedded rather than copied next to the executable: the single-file
    downloads are one file with nothing beside them, and the MIT licences of
    the bundled libraries want their notices to travel with the software.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

</Project>
