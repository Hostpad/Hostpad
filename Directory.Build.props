<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Globalization stays on: WPF resolves a specific culture for every binding,
      and invariant mode makes the first bound control throw at load time.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Hostpad</Product>
    <Company>Hostpad</Company>
    <Authors>Denis Torresan</Authors>
    <Copyright>Copyright (C) 2026 Denis Torresan</Copyright>
    <VersionPrefix>1.0.4</VersionPrefix>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Hostpad/Hostpad</RepositoryUrl>
  </PropertyGroup>

</Project>
